# Hosted template for recruitment.ccsbsis.com; never use these placeholders as credentials.
# Keep this file as private .env in the hosted Laravel application, outside the webroot.
APP_NAME="APEC Homes Recruitment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://recruitment.ccsbsis.com
CIF_PUBLIC_ORIGIN=https://recruitment.ccsbsis.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Replace these with the exact database and user assigned in hPanel.
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_HPANEL_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HPANEL_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_HPANEL_DATABASE_USER
DB_PASSWORD=REPLACE_PRIVATELY
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_COOKIE=apec_recruitment_session
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=apec_recruitment
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Keep mail disabled until a recipient and real SMTP acceptance check are approved.
CIF_MAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=null
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=configure-me@example.invalid
MAIL_FROM_NAME="APEC Homes Recruitment"

# Set the confirmed executable path only after verifying PDF recognition on the host.
# CIF_PDFTOTEXT=/confirmed/private/path/to/pdftotext
